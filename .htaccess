# Joy Stories: redirects for Google (served by Hostinger / Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# One home for the site: https://joystories.co (no www, always HTTPS)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Spam pages planted on the old WordPress site (2024 to Jan 2026).
# 410 Gone tells Google they are removed for good, so it drops them fast.
RewriteCond %{REQUEST_URI} !^/(contact|newsletter|joy-calendar)\.php$
RewriteRule \.php$ - [G,L]
RewriteRule ^(news|id|home)/.+$ - [G,L]
RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
RewriteRule \.xml$ - [G,L]

# The Joy Calendar PDF is only handed out by joy-calendar.php, in exchange for an email
RewriteRule ^downloads/ - [F,L]

# Old WordPress addresses that Google still knows, sent to their new pages
RewriteRule ^home/?$ https://joystories.co/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ https://joystories.co/ [R=301,L]
RewriteRule ^about(-us)?/?$ https://joystories.co/about.html [R=301,L]
RewriteRule ^contact(-us)?/?$ https://joystories.co/contact.html [R=301,L]
RewriteRule ^services/?$ https://joystories.co/team-building.html [R=301,L]
RewriteRule ^services/.*team.*$ https://joystories.co/team-building.html [R=301,L]
RewriteRule ^services/.*engag.*$ https://joystories.co/employee-engagement.html [R=301,L]
RewriteRule ^services/.*train.*$ https://joystories.co/training.html [R=301,L]
RewriteRule ^services/.*event.*$ https://joystories.co/events.html [R=301,L]
RewriteRule ^services/.+$ https://joystories.co/team-building.html [R=301,L]
RewriteRule ^(team-building|employee-engagement|training|events|journal|play)/?$ https://joystories.co/$1.html [R=301,L]
RewriteRule ^(corporate-)?events?/?$ https://joystories.co/events.html [R=301,L]
RewriteRule ^(blog|category|tag|author)(/.*)?$ https://joystories.co/journal.html [R=301,L]
RewriteRule ^(19|20)[0-9]{2}/.*$ https://joystories.co/journal.html [R=301,L]
RewriteRule ^(gallery|portfolio|clients?)/?$ https://joystories.co/journal.html [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ https://joystories.co/journal.html [R=301,L]
RewriteRule ^wp-(content|includes|json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin)(/.*)?$ - [G,L]
</IfModule>

# Faster pages: compress text, cache images and assets
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 month"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
